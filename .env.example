# =============================================
# Sentinel Audit Tool — Variáveis de Ambiente
# Copie para .env e preencha os valores reais (o .env NÃO deve ser versionado)
# =============================================

# --- Banco de dados (use senha forte fora do ambiente local) ---
POSTGRES_PASSWORD=admin

# --- Segurança da API ---
# Chave exigida em toda a API (header X-API-Key ou Authorization: Bearer). Gere com: openssl rand -hex 32
API_KEY=

# --- Segredos cadastrados nos sistemas ---
# Token Git, segredo de webhook e URL de notificação de cada sistema ficam no cadastro do sistema (tela Sistemas) e são
# guardados cifrados no banco com esta chave. Vazio = usa a API_KEY; sem as duas, a API cria uma chave sozinha no volume audit_secrets. Guarde-a: sem ela os segredos salvos não abrem.
# Gere com: openssl rand -hex 32
SECRETS_KEY=

# --- Dependências (OSV.dev) ---
# Só nome/versão dos pacotes são enviados. Em rede fechada: OSV_ENABLED=false ou OSV_URL de um espelho interno.
OSV_ENABLED=true
OSV_URL=https://api.osv.dev

# --- Login corporativo (opcional; veja o README, seção OIDC) ---
# OIDC_AUTH_SERVER_URL=https://keycloak.exemplo.com/realms/sentinel
# OIDC_CLIENT_ID=sentinel-audit

# --- Ferramentas externas (usadas só se instaladas; a imagem Docker já traz Trivy e Gitleaks) ---
# Rede fechada: baixe a base do Trivy antes e use TRIVY_SKIP_DB_UPDATE=true
TRIVY_ENABLED=true
TRIVY_SCANNERS=vuln,misconfig

# Evidências offline: pasta no host com uma subpasta por sistema (veja docs/evidencias/README.md)
EVIDENCE_HOST_DIR=./evidencias
EVIDENCE_MIN_LINE_COVERAGE=60

# Pasta local como origem do sistema (desligada por padrão).
# Para ligar: aponte PROJECTS_HOST_DIR para a pasta que contém seus projetos e defina SENTINEL_LOCAL_ROOT=/projects
# PROJECTS_HOST_DIR=./projetos
# SENTINEL_LOCAL_ROOT=/projects
GITLEAKS_ENABLED=true
# Lint: só rodam se o executável estiver instalado (pmd; eslint + configuração em /opt/eslint)
PMD_ENABLED=true
ESLINT_ENABLED=true
# Padrão TypeScript/Angular (clean code): construa a imagem com WITH_ESLINT=true e troque a configuração por
#   ESLINT_CONFIG=/opt/eslint/eslint.padrao-ts.config.mjs   (e use o perfil padrao-typescript-angular no sistema)
# Google TypeScript + Angular Style Guide + Sonar (contradiz o padrão da casa acima; use um ou outro):
#   ESLINT_CONFIG=/opt/eslint/eslint.google-angular.config.mjs   (e use o perfil padrao-google-typescript-angular)
WITH_ESLINT=true
ESLINT_CONFIG=/opt/eslint/eslint.config.mjs
# Clean code (métricas internas, sem ferramenta externa): limites por função
CLEANCODE_ENABLED=true
CLEANCODE_MAX_FUNCTION_LINES=50
CLEANCODE_MAX_PARAMETERS=5
CLEANCODE_MAX_COMPLEXITY=10
CLEANCODE_MAX_NESTING=4

# --- Pacotes de regras (README: "Pacotes de regras") ---
# Pastas extras de pacotes (separadas por vírgula) e/ou um repositório Git central (somente leitura)
PACKS_DIRS=
PACKS_GIT_URL=
PACKS_GIT_REF=main
PACKS_GIT_PATH=
PACKS_DISABLED=
# Pacote que executa ferramenta externa (modo 'command') só roda se for liberado aqui. Leia a seção de segurança do README.
PACKS_ALLOW_TOOLS=false
# Pacotes embutidos cujas ferramentas (Bandit, Checkov, Hadolint...) rodam mesmo com PACKS_ALLOW_TOOLS=false. Vazio = nenhum.
PACKS_TRUSTED_TOOL_PACKS=market-tools,java-google-style
# Assinatura: chave pública (Base64) e exigência. Gere com: sentinel-pack keygen minha-chave
PACKS_PUBLIC_KEY=
PACKS_REQUIRE_SIGNATURE=false
# Laboratório de regras (executa o Semgrep sobre texto enviado pelo usuário)
PLAYGROUND_ENABLED=true
# --- CORS (só necessário se o dashboard for servido de outra origem) ---
CORS_ORIGINS=http://localhost:3000

