# =============================================
# Sentinel Audit Tool — Variáveis de Ambiente
# Copie para .env e preencha (o .env NÃO deve ser versionado).
# Só entra aqui o que você precisa decidir. Tudo o que não aparece tem um padrão que funciona; a lista completa
# está em docker-compose.yml e em docs/referencia. Ferramentas, pacotes e Git também mudam na tela Configurações
# (último item do menu), e o valor salvo lá vale mais que este arquivo.
# =============================================

# --- Obrigatórias ---
POSTGRES_PASSWORD=

# Chave exigida em toda a API (header X-API-Key ou Authorization: Bearer). Gere com: openssl rand -hex 32
API_KEY=

# Cifra os tokens Git, segredos de webhook e URLs de notificação cadastrados nos sistemas. Gere com: openssl rand -hex 32
# Vazio = usa a API_KEY; sem as duas, a API cria uma chave no volume audit_secrets. Guarde-a: sem ela os segredos salvos não abrem.
SECRETS_KEY=

# --- Capacidade e retenção ---
# Quantas auditorias rodam ao mesmo tempo; as outras esperam vaga.
# AUDIT_MAX_CONCURRENT=2
# Apaga auditorias antigas por dia (AUDIT_RETENTION_DAYS=0 desliga), sempre guardando as AUDIT_RETENTION_KEEP mais recentes de cada sistema.
# AUDIT_RETENTION_DAYS=0
# AUDIT_RETENTION_KEEP=20

# --- Rede corporativa ---
# Proxy usado no build da imagem (e o CA raiz da empresa em audit-api/certs/).
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
# Rede fechada: OSV_ENABLED=false ou OSV_URL de um espelho interno; Trivy: baixe a base antes e use TRIVY_SKIP_DB_UPDATE=true
# OSV_ENABLED=true
# OSV_URL=https://api.osv.dev

# --- Pastas no host (cada máquina tem as suas) ---
# Evidências offline: uma subpasta por sistema (docs/evidencias/README.md)
# EVIDENCE_HOST_DIR=./evidencias
# Cache Maven do Trivy, somente leitura (docs/guia/cache-maven.md); vazio usa ./.m2-cache
# M2_HOST_DIR=./.m2-cache
# Pasta local como origem do sistema (desligada por padrão): aponte para a pasta dos projetos e defina SENTINEL_LOCAL_ROOT=/projects
# PROJECTS_HOST_DIR=./projetos
# SENTINEL_LOCAL_ROOT=/projects

# --- Pacotes de regras externos (README: "Pacotes de regras") ---
# Pastas extras (separadas por vírgula) e/ou um repositório Git central, somente leitura
# PACKS_DIRS=
# PACKS_GIT_URL=
# PACKS_GIT_REF=main
# PACKS_GIT_PATH=
# Pacote que executa ferramenta externa só roda se liberado: PACKS_ALLOW_TOOLS=true (leia a seção de segurança do README)
# Assinatura: chave pública (Base64) e exigência. Gere com: sentinel-pack keygen minha-chave
# PACKS_PUBLIC_KEY=
# PACKS_REQUIRE_SIGNATURE=false

# --- Só se o dashboard for servido de outra origem ---
# CORS_ORIGINS=http://localhost:3000

# --- Login corporativo OIDC (README, seção OIDC). O docker-compose não repassa estas; use no Helm ou exporte no container ---
# OIDC_AUTH_SERVER_URL=https://keycloak.exemplo.com/realms/sentinel
# OIDC_CLIENT_ID=sentinel-audit
