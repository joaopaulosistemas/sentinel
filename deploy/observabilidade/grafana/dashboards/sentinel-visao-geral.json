{
 "uid": "sentinel-visao-geral",
 "title": "Sentinel — visão geral",
 "tags": [
  "sentinel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "description": "Saúde da API, auditorias, analisadores, JVM e logs. Traces: Explore > Tempo.",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "API no ar",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "up{job=\"sentinel-api\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "FORA",
         "color": "red"
        },
        "1": {
         "text": "NO AR",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Auditorias em 24 h (por resultado)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(sentinel_audit_duration_seconds_count[24h]))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Achados em 24 h",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(sentinel_findings_total[24h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Conexões ativas no banco",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(agroal_active_count)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requisições por segundo (por status)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Latência da API (média e máxima)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_requests_seconds_sum[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
     "legendFormat": "média",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "max(http_server_requests_seconds_max)",
     "legendFormat": "máxima",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Duração por analisador (p95, última hora)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, analyzer) (rate(sentinel_analyzer_duration_seconds_bucket[1h])))",
     "legendFormat": "{{analyzer}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Duração da auditoria (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(sentinel_audit_duration_seconds_bucket[1h])))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "barchart",
   "title": "Achados por analisador (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (analyzer) (increase(sentinel_findings_total[24h]))",
     "legendFormat": "{{analyzer}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "table",
   "title": "Situação de cada analisador (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (analyzer, status) (increase(sentinel_analyzer_duration_seconds_count[24h]))",
     "format": "table",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Heap da JVM",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "usado",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
     "legendFormat": "máximo",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Pausas de GC e CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m]))",
     "legendFormat": "GC (s/s)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "process_cpu_usage",
     "legendFormat": "CPU do processo",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Threads e conexões do banco",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "jvm_threads_live_threads",
     "legendFormat": "threads",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A"
    },
    {
     "expr": "sum(agroal_active_count)",
     "legendFormat": "conexões ativas",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "logs",
   "title": "Logs de aviso e erro",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "expr": "{service_name=\"sentinel-audit-api\"} |~ \"(?i)warn|error\"",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}