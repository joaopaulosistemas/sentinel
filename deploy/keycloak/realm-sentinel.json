{
  "realm": "sentinel",
  "enabled": true,
  "displayName": "Sentinel Audit Tool",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@sentinel.local",
    "fromDisplayName": "Sentinel Audit Tool",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "sentinel-admin",
        "description": "Administra sistemas, regras, pacotes e configurações; também executa auditorias"
      },
      {
        "name": "sentinel-executor",
        "description": "Dispara e acompanha auditorias; leitura dos resultados"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@sentinel.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Administradora",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "sentinel-admin"
      ]
    },
    {
      "username": "executor",
      "enabled": true,
      "email": "executor@sentinel.local",
      "emailVerified": true,
      "firstName": "Eduardo",
      "lastName": "Executor",
      "credentials": [
        {
          "type": "password",
          "value": "executor",
          "temporary": false
        }
      ],
      "realmRoles": [
        "sentinel-executor"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "sentinel-dashboard",
      "name": "Painel do Sentinel",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia-sentinel-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sentinel-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sentinel-cli",
      "name": "CLI e scripts (senha direta, só protótipo)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audiencia-sentinel-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sentinel-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sentinel-api",
      "name": "API do Sentinel (só valida tokens)",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "sentinel-teste-sem-audiencia",
      "name": "Só para provar que a API recusa token de outro destino",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "loginTheme": "sentinel",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR"
  ],
  "defaultLocale": "pt-BR"
}
