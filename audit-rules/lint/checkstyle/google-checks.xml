<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Google Java Style Guide (https://google.github.io/styleguide/javaguide.html) verificado pelo Checkstyle.
  Usado pelo perfil padrao-google-java (ferramenta checkstyle-google do pacote java-google-style).
  Cada módulo aponta a seção do guia que verifica. O que não dá para verificar por máquina (nome que descreve a
  intenção, ordem lógica dos membros, escolha entre quebras de linha equivalentes) fica para a revisão de código.
  Não repete os módulos que o checks.xml padrão (ferramenta checkstyle, pacote market-tools) já executa, para o mesmo
  problema não ser contado duas vezes: ArrayTypeStyle, AvoidStarImport, FallThrough, MissingSwitchDefault,
  ModifierOrder, MultipleVariableDeclarations, NoFinalizer, OneStatementPerLine, RedundantImport, UnusedImports e
  UpperEll (4.8.x e 3.3 do guia). O perfil mantém as duas ferramentas ativas.
  Severidade: warning (o Sentinel mapeia para LOW). Os achados de estilo não bloqueiam; formatação se resolve com
  google-java-format, que aplica quase tudo isto sozinho.
-->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="charset" value="UTF-8"/>
  <property name="fileExtensions" value="java"/>

  <!-- 2.3.1 Sem tabulação; 4.2 recuo por espaços -->
  <module name="FileTabCharacter"><property name="eachLine" value="true"/></module>

  <!-- 4.4 Limite de 100 colunas (exceto package, import e URLs longas) -->
  <module name="LineLength">
    <property name="max" value="100"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
  </module>

  <module name="TreeWalker">
    <!-- 3.4.1 Uma classe de topo por arquivo, com o nome do arquivo -->
    <module name="OneTopLevelClass"/>
    <module name="OuterTypeFilename"/>

    <!-- 3.3 Imports: sem curinga, sem quebra de linha, estáticos primeiro, ordem ASCII -->
    <module name="NoLineWrap"><property name="tokens" value="PACKAGE_DEF, IMPORT, STATIC_IMPORT"/></module>
    <module name="CustomImportOrder">
      <property name="sortImportsInGroupAlphabetically" value="true"/>
      <property name="separateLineBetweenGroups" value="true"/>
      <property name="customImportOrderRules" value="STATIC###THIRD_PARTY_PACKAGE"/>
    </module>

    <!-- 4.1 Chaves: obrigatórias, estilo K&R, bloco vazio só como {} -->
    <module name="NeedBraces"><property name="tokens" value="LITERAL_DO, LITERAL_ELSE, LITERAL_FOR, LITERAL_IF, LITERAL_WHILE"/></module>
    <module name="LeftCurly"><property name="tokens" value="ANNOTATION_DEF, CLASS_DEF, CTOR_DEF, ENUM_CONSTANT_DEF, ENUM_DEF, INTERFACE_DEF, LAMBDA, LITERAL_CASE, LITERAL_CATCH, LITERAL_DEFAULT, LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_SWITCH, LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE, METHOD_DEF, OBJBLOCK, STATIC_INIT, RECORD_DEF, COMPACT_CTOR_DEF"/></module>
    <module name="RightCurly">
      <property name="id" value="RightCurlySame"/>
      <property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_DO"/>
    </module>
    <module name="RightCurly">
      <property name="id" value="RightCurlyAlone"/>
      <property name="option" value="alone"/>
      <property name="tokens" value="CLASS_DEF, METHOD_DEF, CTOR_DEF, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT, ANNOTATION_DEF, ENUM_DEF, INTERFACE_DEF, RECORD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
      <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
    </module>

    <!-- 4.1.3 e 6.2 Exceção capturada nunca é ignorada em silêncio (comentário explica, ou variável 'expected') -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>

    <!-- 4.2 Recuo de 2 espaços; continuação de linha de 4 -->
    <module name="Indentation">
      <property name="basicOffset" value="2"/>
      <property name="braceAdjustment" value="2"/>
      <property name="caseIndent" value="2"/>
      <property name="throwsIndent" value="4"/>
      <property name="lineWrappingIndentation" value="4"/>
      <property name="arrayInitIndent" value="2"/>
    </module>

    <!-- 4.5 Quebra de linha: operador vai para a linha seguinte, vírgula e ponto ficam no fim/início conforme o caso -->
    <module name="OperatorWrap">
      <property name="option" value="NL"/>
      <property name="tokens" value="BAND, BOR, BSR, BXOR, DIV, EQUAL, GE, GT, LAND, LE, LITERAL_INSTANCEOF, LOR, LT, MINUS, MOD, NOT_EQUAL, PLUS, QUESTION, SL, SR, STAR, METHOD_REF"/>
    </module>
    <module name="SeparatorWrap">
      <property name="id" value="SeparatorWrapDot"/>
      <property name="tokens" value="DOT"/>
      <property name="option" value="nl"/>
    </module>
    <module name="SeparatorWrap">
      <property name="id" value="SeparatorWrapComma"/>
      <property name="tokens" value="COMMA"/>
      <property name="option" value="EOL"/>
    </module>

    <!-- 4.6 Espaços em branco -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyLambdas" value="true"/>
      <property name="allowEmptyMethods" value="true"/>
      <property name="allowEmptyTypes" value="true"/>
      <property name="allowEmptyLoops" value="true"/>
      <property name="ignoreEnhancedForColon" value="false"/>
    </module>
    <module name="WhitespaceAfter"/>
    <module name="NoWhitespaceBefore"><property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC, ELLIPSIS"/><property name="allowLineBreaks" value="true"/></module>
    <module name="GenericWhitespace"/>
    <module name="MethodParamPad"/>
    <module name="ParenPad"/>
    <module name="TypecastParenPad"/>
    <module name="EmptyLineSeparator">
      <property name="tokens" value="PACKAGE_DEF, IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF, STATIC_INIT, INSTANCE_INIT, METHOD_DEF, CTOR_DEF, VARIABLE_DEF, RECORD_DEF, COMPACT_CTOR_DEF"/>
      <property name="allowNoEmptyLineBetweenFields" value="true"/>
    </module>



    <!-- 4.8.5 Anotações: uma por linha em classe/pacote; posição correta -->
    <module name="AnnotationLocation">
      <property name="id" value="AnnotationLocationMostCases"/>
      <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, METHOD_DEF, CTOR_DEF, RECORD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <module name="AnnotationLocation">
      <property name="id" value="AnnotationLocationVariables"/>
      <property name="tokens" value="VARIABLE_DEF"/>
      <property name="allowSamelineMultipleAnnotations" value="true"/>
    </module>


    <!-- 4.8.8 Comentários alinhados ao código -->
    <module name="CommentsIndentation"/>

    <!-- 3.4.2 Sobrecargas ficam juntas -->
    <module name="OverloadMethodsDeclarationOrder"/>
    <module name="VariableDeclarationUsageDistance"/>

    <!-- 5 Nomenclatura -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
      <message key="name.invalidPattern" value="Nome de pacote ''{0}'' deve ter só letras minúsculas e dígitos, sem underscore (Google Java Style 5.2.1)."/>
    </module>
    <module name="TypeName">
      <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
      <message key="name.invalidPattern" value="Nome de tipo ''{0}'' deve estar em UpperCamelCase (Google Java Style 5.2.2)."/>
    </module>
    <module name="MemberName">
      <property name="format" value="^[a-z][a-z0-9][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="Campo ''{0}'' deve estar em lowerCamelCase, sem prefixo ou sufixo como m, _ ou k (Google Java Style 5.2.5)."/>
    </module>
    <module name="StaticVariableName">
      <property name="format" value="^[a-z][a-z0-9][a-zA-Z0-9]*$"/>
      <message key="name.invalidPattern" value="Campo estático ''{0}'' deve estar em lowerCamelCase; UPPER_SNAKE_CASE é só para constante (Google Java Style 5.2.5)."/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <property name="accessModifiers" value="public"/>
      <message key="name.invalidPattern" value="Parâmetro ''{0}'' deve estar em lowerCamelCase e, em método público, ter mais de um caractere (Google Java Style 5.2.6)."/>
    </module>
    <module name="ParameterName">
      <property name="id" value="ParameterNameNonPublic"/>
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <property name="accessModifiers" value="protected, package, private"/>
      <message key="name.invalidPattern" value="Parâmetro ''{0}'' deve estar em lowerCamelCase (Google Java Style 5.2.6)."/>
    </module>
    <module name="LambdaParameterName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <message key="name.invalidPattern" value="Parâmetro de lambda ''{0}'' deve estar em lowerCamelCase (Google Java Style 5.2.6)."/>
    </module>
    <module name="CatchParameterName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <message key="name.invalidPattern" value="Parâmetro de catch ''{0}'' deve estar em lowerCamelCase (Google Java Style 5.2.6)."/>
    </module>
    <module name="LocalVariableName">
      <property name="tokens" value="VARIABLE_DEF"/>
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <message key="name.invalidPattern" value="Variável local ''{0}'' deve estar em lowerCamelCase, mesmo sendo final (Google Java Style 5.2.7)."/>
    </module>
    <module name="PatternVariableName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <message key="name.invalidPattern" value="Variável de padrão ''{0}'' deve estar em lowerCamelCase (Google Java Style 5.2.7)."/>
    </module>
    <module name="RecordComponentName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
      <message key="name.invalidPattern" value="Componente de record ''{0}'' deve estar em lowerCamelCase (Google Java Style 5.2.5)."/>
    </module>
    <module name="ClassTypeParameterName">
      <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
      <message key="name.invalidPattern" value="Parâmetro de tipo ''{0}'' deve ser uma letra maiúscula (com número opcional) ou um nome terminado em T (Google Java Style 5.2.8)."/>
    </module>
    <module name="RecordTypeParameterName">
      <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
      <message key="name.invalidPattern" value="Parâmetro de tipo ''{0}'' deve ser uma letra maiúscula (com número opcional) ou um nome terminado em T (Google Java Style 5.2.8)."/>
    </module>
    <module name="MethodTypeParameterName">
      <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
      <message key="name.invalidPattern" value="Parâmetro de tipo ''{0}'' deve ser uma letra maiúscula (com número opcional) ou um nome terminado em T (Google Java Style 5.2.8)."/>
    </module>
    <module name="InterfaceTypeParameterName">
      <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
      <message key="name.invalidPattern" value="Parâmetro de tipo ''{0}'' deve ser uma letra maiúscula (com número opcional) ou um nome terminado em T (Google Java Style 5.2.8)."/>
    </module>
    <module name="MethodName">
      <property name="format" value="^[a-z][a-z0-9]\w*$"/>
      <message key="name.invalidPattern" value="Método ''{0}'' deve estar em lowerCamelCase (Google Java Style 5.2.3)."/>
    </module>
    <!-- 5.3 Camel case: siglas contam como palavra (HttpUrl, não HTTPUrl) -->
    <module name="AbbreviationAsWordInName">
      <property name="ignoreFinal" value="false"/>
      <property name="ignoreStatic" value="false"/>
      <property name="ignoreStaticFinal" value="true"/>
      <property name="allowedAbbreviationLength" value="1"/>
      <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, ANNOTATION_FIELD_DEF, PARAMETER_DEF, VARIABLE_DEF, METHOD_DEF, PATTERN_VARIABLE_DEF, RECORD_DEF, RECORD_COMPONENT_DEF"/>
    </module>
    <!-- 5.2.4 Constante: UPPER_SNAKE_CASE (static final) -->
    <module name="ConstantName">
      <message key="name.invalidPattern" value="Constante ''{0}'' deve estar em UPPER_SNAKE_CASE (Google Java Style 5.2.4)."/>
    </module>

    <!-- 6.1 @Override sempre que cabe -->
    <module name="MissingOverride"/>

    <!-- 2.3.3 e 2.3.2 Sem escape Unicode desnecessário -->
    <module name="AvoidEscapedUnicodeCharacters">
      <property name="allowEscapesForControlCharacters" value="true"/>
      <property name="allowByTailComment" value="true"/>
      <property name="allowNonPrintableEscapes" value="true"/>
    </module>

    <!-- 7 Javadoc -->
    <module name="InvalidJavadocPosition"/>
    <module name="JavadocParagraph"/>
    <module name="JavadocTagContinuationIndentation"><property name="offset" value="4"/></module>
    <module name="SummaryJavadoc">
      <property name="forbiddenSummaryFragments" value="^@return the *|^This method returns |^A [{]@code [a-zA-Z0-9]+[}]( is a )"/>
    </module>
    <module name="AtclauseOrder">
      <property name="tagOrder" value="@param, @return, @throws, @deprecated"/>
      <property name="target" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, METHOD_DEF, CTOR_DEF, VARIABLE_DEF"/>
    </module>
    <module name="NonEmptyAtclauseDescription"/>
    <module name="SingleLineJavadoc"><property name="ignoreInlineTags" value="false"/></module>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public"/>
      <property name="allowMissingParamTags" value="true"/>
      <property name="allowMissingReturnTag" value="true"/>
      <property name="allowedAnnotations" value="Override, Test"/>
      <property name="validateThrows" value="false"/>
    </module>
    <module name="MissingJavadocType">
      <property name="scope" value="protected"/>
      <property name="skipAnnotations" value="Generated"/>
      <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="minLineCount" value="2"/>
      <property name="allowedAnnotations" value="Override, Test"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
    </module>
  </module>
</module>
