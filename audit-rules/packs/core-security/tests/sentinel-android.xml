<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.exemplo">
    <!-- ruleid: sentinel-android-manifest-allow-backup -->
    <application android:allowBackup="true"
        <!-- ruleid: sentinel-android-manifest-cleartext -->
        android:usesCleartextTraffic="true">
        <!-- ruleid: sentinel-android-manifest-exported -->
        <activity android:name=".Envio" android:exported="true" />
        <!-- ok: sentinel-android-manifest-exported -->
        <activity android:name=".Interna" android:exported="false" />
        <!-- ruleid: sentinel-android-manifest-exported -->
        <activity android:name=".Antes" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
            </intent-filter>
        </activity>
        <!-- ok: sentinel-android-manifest-exported -->
        <activity android:name=".Principal" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ruleid: sentinel-android-manifest-exported -->
        <activity android:name=".Deep" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
            </intent-filter>
        </activity>
        <!-- ruleid: sentinel-android-manifest-intent-filter-implicito -->
        <activity
            android:name=".Creds"
            android:label="@string/creds" >
            <intent-filter>
                <action android:name="app.action.VIEW_CREDS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- ok: sentinel-android-manifest-intent-filter-implicito -->
        <activity android:name=".Fechada" android:exported="false">
            <intent-filter>
                <action android:name="app.action.INTERNA" />
            </intent-filter>
        </activity>
        <!-- ok: sentinel-android-manifest-intent-filter-implicito -->
        <activity android:name=".Entrada">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ok: sentinel-android-manifest-intent-filter-implicito -->
        <activity android:name=".SemFiltro" />
    </application>
</manifest>
