{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"web/bad.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":13,"endLine":1,"snippet":{"text":"const a: any = 1;"},"startColumn":8,"startLine":1}}}],"message":{"text":"Uso explícito de 'any' desliga a checagem de tipos exatamente onde ela mais ajudaria. Use o tipo correto, um tipo genérico ou 'unknown' (que obriga a verificar antes de usar).\n"},"properties":{},"ruleId":"audit-rules.packs.core-quality.rules.sentinel-ts-any-explicito"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"web/bad.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":6,"endLine":2,"snippet":{"text":"var b = 2;"},"startColumn":1,"startLine":2}}}],"message":{"text":"'var' tem escopo de função e sofre hoisting, fonte clássica de bugs. Use const (padrão) ou let.\n"},"properties":{},"ruleId":"audit-rules.packs.core-quality.rules.sentinel-ts-var"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"web/bad.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":11,"endLine":3,"snippet":{"text":"if (a == b) { console.log(\"x\"); }"},"startColumn":5,"startLine":3}}}],"message":{"text":"'==' e '!=' convertem tipos antes de comparar ('0' == 0, '' == false). Use '===' e '!=='. (Comparar com null/undefined usando == é a única exceção aceita.)\n"},"properties":{},"ruleId":"audit-rules.packs.core-quality.rules.sentinel-ts-igualdade-frouxa"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"web/bad.ts","uriBaseId":"%SRCROOT%"},"region":{"endColumn":31,"endLine":3,"snippet":{"text":"if (a == b) { console.log(\"x\"); }"},"startColumn":15,"startLine":3}}}],"message":{"text":"console.log esquecido no códi